{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Web: Vite dev server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/apps/web",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Web: Chrome",
        "pattern": "Local:.*(https?://[a-zA-Z0-9.:]+)"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Web: Chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
      "runtimeArgs": [
        "--test-type",
        "--disable-blink-features=AutomationControlled"
      ]
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Worker: wrangler dev",
      "command": "PATH=\"$HOME/.cargo/bin:$PATH\" npx wrangler dev --ip 127.0.0.1 --port 8787 --inspector-port 9229",
      "cwd": "${workspaceFolder}/apps/worker"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Worker: attach inspector",
      "port": 9229,
      "cwd": "${workspaceFolder}/apps/worker",
      "resolveSourceMapLocations": null,
      "attachExistingChildren": false,
      "autoAttachChildProcesses": false,
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Web + Worker",
      "configurations": ["Web: Vite dev server", "Worker: wrangler dev"],
      "stopAll": true
    }
  ]
}
