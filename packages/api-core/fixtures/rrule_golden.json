{
  "comment": "Golden fixtures for RRULE expansion (ADR 0004). Each case is a stored routine definition — naive local civil dtstart + RRULE body + exdates — and the local YYYY-MM-DD dates the engine must produce inside the inclusive window [from, to]. The SAME cases must pass on BOTH engines: the Rust crate (packages/api-core/src/routines.rs::occurrence_dates, asserted in routines.rs tests) and the npm rrule runner (/routines builder, slice 3). Expansion is floating local civil time; the tzdb is never used.",
  "cases": [
    {
      "name": "daily inclusive window",
      "dtstart": "2026-01-01T06:30:00",
      "rrule": "FREQ=DAILY",
      "exdates": [],
      "from": "2026-01-02",
      "to": "2026-01-04",
      "expected": ["2026-01-02", "2026-01-03", "2026-01-04"]
    },
    {
      "name": "weekly BYDAY=MO,WE",
      "dtstart": "2026-01-05T07:00:00",
      "rrule": "FREQ=WEEKLY;BYDAY=MO,WE",
      "exdates": [],
      "from": "2026-01-11",
      "to": "2026-01-17",
      "expected": ["2026-01-12", "2026-01-14"]
    },
    {
      "name": "daily INTERVAL=2",
      "dtstart": "2026-01-01T06:00:00",
      "rrule": "FREQ=DAILY;INTERVAL=2",
      "exdates": [],
      "from": "2026-01-01",
      "to": "2026-01-07",
      "expected": ["2026-01-01", "2026-01-03", "2026-01-05", "2026-01-07"]
    },
    {
      "name": "UNTIL bounds the series",
      "dtstart": "2026-01-01T06:30:00",
      "rrule": "FREQ=DAILY;UNTIL=20260104T063000Z",
      "exdates": [],
      "from": "2025-12-31",
      "to": "2026-02-28",
      "expected": ["2026-01-01", "2026-01-02", "2026-01-03", "2026-01-04"]
    },
    {
      "name": "exdates remove their local date",
      "dtstart": "2026-01-01T06:30:00",
      "rrule": "FREQ=DAILY;COUNT=5",
      "exdates": ["2026-01-03"],
      "from": "2026-01-01",
      "to": "2026-01-31",
      "expected": ["2026-01-01", "2026-01-02", "2026-01-04", "2026-01-05"]
    }
  ]
}
