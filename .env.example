# Sanctuary Environment Configuration

## Worker (deployed secrets: `wrangler secret put`; local dev: copy
## apps/worker/.dev.vars.example to apps/worker/.dev.vars and fill in)

SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars
GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"YOUR_CLIENT_ID","client_secret":"YOUR_CLIENT_SECRET","redirect_uris":["http://localhost:5173/auth/google/callback","https://my-sanctuary.fahimalizain.com/auth/google/callback"]}}
FRONTEND_URL=http://localhost:5173
SECURE_COOKIE=false

## Web

# Optional override; defaults to same-origin (''). The Vite dev server proxies
# /api, /auth, /health and /version to the local worker at 127.0.0.1:8787.
VITE_API_BASE_URL=
