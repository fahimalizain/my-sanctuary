{
  "name": "worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/worker",
  "tags": [],
  "implicitDependencies": ["api-core", "web"],
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": ["worker-build --release"],
        "cwd": "apps/worker"
      },
      "outputs": ["{projectRoot}/build"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["wrangler dev"],
        "cwd": "apps/worker"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["wrangler deploy"],
        "cwd": "apps/worker"
      }
    },
    "test-d1": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cargo test -p d1-sync"],
        "cwd": "."
      },
      "inputs": [
        "{workspaceRoot}/packages/d1-sync/**",
        "{workspaceRoot}/packages/api-core/**",
        "{workspaceRoot}/apps/worker/migrations/**",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock"
      ],
      "cache": true
    }
  }
}
